{
	"manifest_version": 3,
	"name": "Time Machine",
	"description": "Slow down time",
	"version": "1.2.4",
	"options_page": "options.html",
	"permissions": [
		"storage"
	],
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"dilate.js"
			],
			"run_at": "document_start",
			"world": "MAIN",
			"all_frames": true
		},
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"settings.js"
			],
			"run_at": "document_start",
			"all_frames": true
		}
	]
}