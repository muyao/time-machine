{
	"manifest_version": 3,
	"name": "Time Machine",
	"description": "Slow down time",
	"version": "1.2.7",
	"options_page": "options.html",
	"permissions": [
		"storage"
	],
	"icons": {
		"128": "img/icons/128x.png",
		"48": "img/icons/48x.png",
		"32": "img/icons/32x.png",
		"16": "img/icons/16x.png"
	},
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"dilate.js"
			],
			"run_at": "document_start",
			"world": "MAIN",
			"all_frames": true
		},
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"settings.js"
			],
			"run_at": "document_start",
			"all_frames": true
		}
	]
}